# --- Storage ---------------------------------------------------------------
# DATA_DIR=C:\ruta\a\clipforge\data
# Directorio donde se guardan trabajos, clips y la base de datos SQLite.

# --- Binarios --------------------------------------------------------------
# Si ffmpeg no esta en el PATH, apunta a la ruta del ejecutable.
# FFMPEG_BIN=C:\clipforge\tools\ffmpeg\bin\ffmpeg.exe
# FFPROBE_BIN=C:\clipforge\tools\ffmpeg\bin\ffprobe.exe

# --- Transcripcion (faster-whisper) ---------------------------------------
# tiny | base | small | medium | large-v3  (small = buen equilibrio CPU/calidad)
WHISPER_MODEL=small
# auto | cpu | cuda
WHISPER_DEVICE=auto
# int8 (CPU), float16 (GPU), int8_float16 (GPU con poca VRAM)
WHISPER_COMPUTE=int8

# --- Analisis con LLM (opcional) ------------------------------------------
# Sin clave, el motor usa el analizador heuristico local (funciona offline).
# LLM_API_KEY=sk-...
# Cualquier endpoint compatible con OpenAI Chat Completions:
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# Tambien vale Ollama: http://localhost:11434/v1 con LLM_MODEL=llama3.1

# --- Limites ---------------------------------------------------------------
MAX_UPLOAD_MB=2048
MAX_SOURCE_MINUTES=0

# --- Subtitulos y render --------------------------------------------------
SUBTITLE_FONT=Arial
# shorts (palabra a palabra) | bold | clean | neon | minimal
SUBTITLE_STYLE=shorts
MUSIC_VOLUME=0.14

# --- YouTube ---------------------------------------------------------------
# Archivo de cookies en formato Netscape, solo si tienes derecho a usar la cuenta.
# YTDLP_COOKIES=C:\ruta\a\cookies.txt
# Navegador del que leer cookies cuando YouTube pide verificacion.
# edge | chrome | firefox | brave | vivaldi | opera (opcional: edge:Default)
# YTDLP_COOKIES_FROM_BROWSER=edge
# ClipForge prueba cookies del navegador automaticamente si YouTube bloquea.
YTDLP_AUTO_COOKIES=1

# --- Publicacion YouTube / TikTok -----------------------------------------
# Tambien se pueden editar las credenciales desde Ajustes de publicación.
# Los valores se guardan localmente en DATA_DIR/publishing.json.
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=
# YouTube: private | unlisted | public
YOUTUBE_PRIVACY=private
# TikTok: SELF_ONLY | PUBLIC_TO_EVERYONE | MUTUAL_FOLLOW_FRIENDS | FOLLOWER_OF_CREATOR
TIKTOK_PRIVACY=SELF_ONLY
# OAuth escucha solo en loopback. TikTok puede requerir http://localhost.
# PUBLISHING_REDIRECT_HOST=127.0.0.1
PUBLISHING_REDIRECT_PORT=53682

# --- Web -------------------------------------------------------------------
# WEB_DIST=C:\ruta\a\clipforge\web\dist

# --- Servidor cloud / pagos ------------------------------------------------
# El servidor hosted comparte este archivo. Define estas variables para cobrar.
# URL base de PayPal.me. Si se define, la landing y el panel muestran botones
# de pago manual; el administrador activa el plan desde el panel Admin.
# PAYPAL_ME_URL=https://paypal.me/tuusuario
# Alternativa automatica con Stripe (Creator y Studio):
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_CREATOR=
# STRIPE_PRICE_STUDIO=
# Correos con acceso al panel de administracion (separados por coma).
# ADMIN_EMAILS=tu@correo.com
# CLIPFORGE_CLOUD_DIR=C:\ruta\a\cloud
# CLIPFORGE_PUBLIC_ORIGIN=https://tu-dominio.com
