# Copiar a .env.production y rellenar. NUNCA subir .env.production a GitHub.

# Dominio publico. Sin dominio propio use: app.TU_IP.sslip.io
APP_DOMAIN=app.TU_IP.sslip.io
CLIPFORGE_PUBLIC_ORIGIN=https://app.TU_IP.sslip.io

# Cuenta de administrador. ADMIN_EMAILS la usa el panel Admin.
ADMIN_EMAILS=Leowysgarcia@gmail.com

# PayPal Subscriptions: el cliente paga y el plan se activa automaticamente.
# La clave secreta se queda en el servidor. Nunca la subas a GitHub.
PAYPAL_CLIENT_ID=BAAFvUUXDGuhU_4L6MWlDXs4PGXU6gD-OP2v-y_EkUlGvcMCrAcKjRDlPHZdgvWy7l0vAd5bsHQJJ9FqIM
PAYPAL_CLIENT_SECRET=TU_SECRETO_DE_PAYPAL
PAYPAL_MODE=live
PAYPAL_PRODUCT_ID=PROD-0VJ49900FS465031M
PAYPAL_CREATOR_PLAN_ID=P-9JK82163JY201791BNMCPAMA
PAYPAL_STUDIO_PLAN_ID=P-73R478908B315820HNMCPAMI
# URL publica del servidor. Con esto el setup crea el webhook de PayPal.
PAYPAL_PUBLIC_URL=https://app.TU_IP.sslip.io
# Se rellena solo al ejecutar el setup, o pega aqui el ID del webhook de PayPal.
PAYPAL_WEBHOOK_ID=

# Motor de clips. medium/large-v3 dan maxima calidad; small es mas rapido.
WHISPER_MODEL=medium
WHISPER_DEVICE=cpu
WHISPER_COMPUTE=int8
CLIPFORGE_MAX_WORKSPACES=2
CLIPFORGE_CLOUD_UPLOAD_MB=512
CLIPFORGE_CLOUD_MAX_MINUTES=0

# Seed del administrador al primer arranque (idempotente).
CLIPFORGE_SEED_ADMIN=1
CLIPFORGE_ADMIN_EMAIL=Leowysgarcia@gmail.com
CLIPFORGE_ADMIN_PASSWORD=CAMBIAR_ESTA_CLAVE

# Opcional: si YouTube pide verificacion, monte un cookie file y apunte aqui.
# YTDLP_COOKIES=/data/cookies.txt
